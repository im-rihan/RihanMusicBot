# Discord Bot Token (from Discord Developer Portal → Bot)
DISCORD_TOKEN=your_bot_token_here

# Application / Client ID (from Discord Developer Portal → General Information)
CLIENT_ID=your_client_id_here

# Optional: deploy slash commands to one guild instantly (recommended for testing)
# Leave empty to deploy globally (can take up to 1 hour)
GUILD_ID=

# Bot owner Discord user ID (for /restart and owner-only commands)
OWNER_ID=your_discord_user_id_here

# Default embed color (hex without #)
EMBED_COLOR=5865F2

# Default volume (0-100)
DEFAULT_VOLUME=50
